import java.util.Scanner;

public class AddToCart {

    static Scanner sc = new Scanner(System.in);

    static String[] productName = {
        "Rice",
        "Sugar",
        "Milk",
        "Biscuits",
        "Soap",
        "Shampoo",
        "Tea",
        "Coffee"
    };

    static double[] price = {
        60.00,
        45.00,
        30.00,
        20.00,
        40.00,
        120.00,
        150.00,
        180.00
    };

    static int[] cartQuantity = new int[productName.length];

    public static void main(String[] args) {

        System.out.println("=================================");
        System.out.println("          KMUKESH MART");
        System.out.println("          ADD TO CART");
        System.out.println("=================================");

        for (int i = 0; i < productName.length; i++) {
            System.out.println(
                (i + 1) + ". " +
                productName[i] +
                " - ₹" + price[i]
            );
        }

        System.out.print("\nEnter Product ID: ");
        int productId = sc.nextInt();

        if (productId < 1 || productId > productName.length) {
            System.out.println("Invalid Product ID!");
            return;
        }

        System.out.print("Enter Quantity: ");
        int quantity = sc.nextInt();

        if (quantity <= 0) {
            System.out.println("Invalid Quantity!");
            return;
        }

        cartQuantity[productId - 1] += quantity;

        System.out.println("\nProduct added successfully!");
        System.out.println("Product  : " + productName[productId - 1]);
        System.out.println("Quantity : " + quantity);
        System.out.println("Price    : ₹" + price[productId - 1]);

        sc.close();
    }
}
